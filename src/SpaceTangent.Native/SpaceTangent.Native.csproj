<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>SpaceTangentNative</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler">
      <ILCompilerPackVersion Condition="'%(TargetFramework)' == 'net8.0'">8.0.33</ILCompilerPackVersion>
    </KnownILCompilerPack>
    <ProjectReference Include="../SpaceTangent.Core/SpaceTangent.Core.csproj" />
  </ItemGroup>
</Project>
